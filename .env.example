# Server-only. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nospamcalls?sslmode=require
IP_HASH_SECRET=generate-a-long-random-string
PUBLIC_SITE_URL=https://nospamcalls.org

# Resend transactional email. Leave RESEND_API_KEY empty to disable sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NoSpamCalls <info@nospamcalls.org>
RESEND_ALERTS_FROM_EMAIL=NoSpamCalls Alerts <alerts@nospamcalls.org>
# HMAC secret for signed unsubscribe links. Falls back to IP_HASH_SECRET if unset.
UNSUBSCRIBE_SECRET=generate-32-random-bytes-as-hex
# Protects /api/cron/* (Vercel sends Authorization: Bearer $CRON_SECRET).
CRON_SECRET=generate-32-random-bytes-as-hex
